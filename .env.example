# Database
DATABASE_URL="mysql://root:password@localhost:3306/esports_tournament_db"

# JWT
JWT_SECRET="your-secret-key"

# Server
NODE_ENV="development"
PORT=3000
LOG_LEVEL="info"

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Webhook URL (ngrok URL para desarrollo local)
WEBHOOK_URL=http://localhost:3000/webhook

# Stripe Price IDs (crear en Stripe Dashboard -> Products)
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_YEARLY_PRICE_ID=price_...
STRIPE_PREMIUM_MONTHLY_PRICE_ID=price_...
STRIPE_PREMIUM_YEARLY_PRICE_ID=price_...

# Stripe URLs
STRIPE_SUCCESS_URL=http://localhost:5173/#/pago/exito
STRIPE_CANCEL_URL=http://localhost:5173/#/suscripcion

# Telegram Bot
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"

# Firebase Admin SDK
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="your-firebase-client-email"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
