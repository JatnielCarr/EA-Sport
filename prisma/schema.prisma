// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ====================== ENUMS ======================

enum TournamentFormat {
  SINGLE_ELIMINATION
  DOUBLE_ELIMINATION
  ROUND_ROBIN
  SWISS
}

enum TournamentStatus {
  DRAFT
  PUBLISHED
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}



enum TeamPlayerStatus {
  ACTIVE
  INACTIVE
  REMOVED
}

enum MatchStatus {
  SCHEDULED
  CHECK_IN
  LIVE
  COMPLETED
  DISPUTED
  CANCELLED
}

enum UserRole {
  USER
  LEADER
  ADMIN
}

// ====================== CLAN ENUMS ======================

enum ClanAccessType {
  OPEN
  INVITE_ONLY
  CLOSED
}

enum ClanMemberRole {
  LEADER
  OFFICER
  MEMBER
}

enum ClanRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// ====================== MODELS ======================

// Subscription Plan Enum
enum SubscriptionPlan {
  FREE
  STANDARD
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  INCOMPLETE
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  username         String   @unique
  password_hash    String
  role             UserRole @default(USER)
  verified           Boolean  @default(false)
  email_verified_at  DateTime?
  email_verify_token String?  @db.VarChar(128)
  balance            Decimal  @default(0) @db.Decimal(10, 2)
  telegram_chat_id   String?  @unique
  stripe_customer_id String?  @unique
  avatar_url         String?  @db.LongText
  banner_url         String?  @db.LongText
  description        String?  @db.VarChar(500)
  name_change_count  Int      @default(0)
  banned             Boolean  @default(false)
  ban_reason         String?  @db.Text
  ban_duration       String?  // "3d", "7d", "14d", "31d", "permanent"
  banned_at          DateTime?
  banned_until       DateTime?
  last_seen_at       DateTime?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  // Relations
  game_accounts         GameAccount[]
  organized_tournaments Tournament[]       @relation("OrganizerTournaments")
  team_memberships      TeamPlayer[]
  captained_teams       Team[]             @relation("TeamCaptain")
  reported_results      MatchResult[]      @relation("ResultReporter")
  validated_results     MatchResult[]      @relation("ResultValidator")
  player_stats          PlayerStats[]
  payments              Payment[]
  subscription          Subscription?
  refresh_tokens        RefreshToken[]
  notifications         Notification[]
  password_resets       PasswordResetToken[]
  match_checkins        MatchCheckIn[]
  
  // Clan Relations
  led_clans             Clan[]             @relation("ClanLeader")
  clan_memberships      ClanMember[]
  clan_requests         ClanRequest[]
  clan_messages         ClanMessage[]

  // Innovation Features
  fcm_token             String?            // Firebase Cloud Messaging token for push notifications
  reputation            PlayerReputation?
  reviews_given         ReputationReview[] @relation("ReviewAuthor")
  reviews_received      ReputationReview[] @relation("ReviewTarget")
  free_agent_profile    FreeAgent?
  free_agent_invites_sent FreeAgentInvite[] @relation("InviteSender")
  
  @@index([email])
  @@index([username])
  @@map("users")
}

model Subscription {
  id                       String             @id @default(cuid())
  user_id                  String             @unique
  plan                     SubscriptionPlan   @default(FREE)
  status                   SubscriptionStatus @default(ACTIVE)
  stripe_subscription_id   String?            @unique
  stripe_price_id          String?
  current_period_start     DateTime?
  current_period_end       DateTime?
  cancel_at_period_end     Boolean            @default(false)
  created_at               DateTime           @default(now())
  updated_at               DateTime           @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([stripe_subscription_id])
  @@map("subscriptions")
}

model RefreshToken {
  id            String   @id @default(cuid())
  token_hash    String   @unique
  user_id       String
  expires_at    DateTime
  revoked       Boolean  @default(false)
  created_at    DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([token_hash])
  @@index([expires_at])
  @@map("refresh_tokens")
}

// ====================== REVENUE & MONETIZATION ======================

enum TransactionType {
  SUBSCRIPTION        // Pago de suscripción
  TOURNAMENT_ENTRY    // Entrada a torneo
  PRIZE_COMMISSION    // Comisión sobre premios
  PRIZE_CREDIT        // Premio depositado en wallet del jugador
  NAME_CHANGE         // Cambio de nombre
  BALANCE_TOPUP       // Recarga de saldo
  WITHDRAWAL          // Retiro de fondos
  REFUND              // Reembolso
  PLATFORM_FEE        // Comisión de plataforma
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model PlatformRevenue {
  id                    String            @id @default(cuid())
  transaction_type      TransactionType
  amount                Decimal           @db.Decimal(10, 2)
  currency              String            @default("mxn")
  status                TransactionStatus @default(PENDING)
  description           String?
  user_id               String?
  tournament_id         String?
  stripe_payment_id     String?
  metadata              Json?
  created_at            DateTime          @default(now())
  
  @@index([transaction_type])
  @@index([created_at])
  @@index([user_id])
  @@index([status])
  @@map("platform_revenue")
}

model TournamentEntry {
  id                    String            @id @default(cuid())
  tournament_id         String
  team_id               String
  user_id               String            // Usuario que pagó
  entry_fee             Decimal           @db.Decimal(10, 2)
  platform_fee          Decimal           @db.Decimal(10, 2)  // Comisión de plataforma
  net_amount            Decimal           @db.Decimal(10, 2)  // Monto neto al prize pool
  status                TransactionStatus @default(PENDING)
  stripe_payment_id     String?
  paid_at               DateTime?
  refunded_at           DateTime?
  created_at            DateTime          @default(now())
  
  @@unique([tournament_id, team_id])
  @@index([tournament_id])
  @@index([user_id])
  @@index([status])
  @@map("tournament_entries")
}

model PrizeDistribution {
  id                    String            @id @default(cuid())
  tournament_id         String
  team_id               String
  position              Int               // 1st, 2nd, 3rd, etc.
  gross_amount          Decimal           @db.Decimal(10, 2)  // Premio bruto
  platform_fee          Decimal           @db.Decimal(10, 2)  // Comisión de plataforma
  net_amount            Decimal           @db.Decimal(10, 2)  // Premio neto
  distributed           Boolean           @default(false)
  distributed_at        DateTime?
  created_at            DateTime          @default(now())
  
  @@unique([tournament_id, team_id])
  @@index([tournament_id])
  @@index([distributed])
  @@map("prize_distributions")
}

model RevenueMetrics {
  id                    String            @id @default(cuid())
  period_type           String            // daily, weekly, monthly
  period_start          DateTime
  period_end            DateTime
  total_revenue         Decimal           @db.Decimal(12, 2)
  subscription_revenue  Decimal           @db.Decimal(12, 2)
  tournament_revenue    Decimal           @db.Decimal(12, 2)
  commission_revenue    Decimal           @db.Decimal(12, 2)
  other_revenue         Decimal           @db.Decimal(12, 2)
  total_transactions    Int
  new_subscribers       Int
  churned_subscribers   Int
  mrr                   Decimal           @db.Decimal(12, 2)  // Monthly Recurring Revenue
  arr                   Decimal           @db.Decimal(12, 2)  // Annual Recurring Revenue
  created_at            DateTime          @default(now())
  
  @@unique([period_type, period_start])
  @@index([period_type])
  @@index([period_start])
  @@map("revenue_metrics")
}

model Payment {
  id                    String   @id @default(cuid())
  user_id               String
  amount                Decimal  @db.Decimal(10, 2)
  currency              String   @default("mxn")
  status                String   // pending, succeeded, failed
  stripe_payment_id     String   @unique
  stripe_session_id     String?  @unique
  metadata              Json?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([stripe_payment_id])
  @@map("payments")
}

model Game {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  developer         String
  icon_url          String?
  team_size_default Int      @default(5)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  // Relations
  game_accounts GameAccount[]
  tournaments   Tournament[]
  player_stats  PlayerStats[]
  free_agents   FreeAgent[]

  @@index([slug])
  @@map("games")
}

model GameAccount {
  id            String    @id @default(cuid())
  user_id       String
  game_id       String
  game_username String
  account_id    String
  rank          String?
  verified      Boolean   @default(false)
  verified_at   DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  game Game @relation(fields: [game_id], references: [id], onDelete: Cascade)

  @@unique([user_id, game_id, account_id])
  @@index([user_id])
  @@index([game_id])
  @@map("game_accounts")
}

model Tournament {
  id                    String           @id @default(cuid())
  name                  String
  slug                  String           @unique
  description           String?          @db.Text
  game_id               String
  organizer_id          String
  format                TournamentFormat
  team_size             Int
  max_participants      Int
  region                String
  entry_fee             Decimal          @default(0) @db.Decimal(10, 2)
  prize_pool            Decimal          @default(0) @db.Decimal(10, 2)
  start_date            DateTime
  end_date              DateTime?
  registration_deadline DateTime
  status                TournamentStatus @default(DRAFT)
  rules_json            Json?
  bracket_generated     Boolean          @default(false)
  invite_code           String?          @unique  // Código único para URL de invitación
  invite_active         Boolean          @default(true)  // Si la invitación está activa
  requires_entry_fee    Boolean          @default(false) // Si requiere pago para entrar

  // Streaming URLs
  twitch_url            String?          // URL del canal de Twitch para transmisiones del torneo
  youtube_url           String?          // URL del canal de YouTube para transmisiones del torneo
  stream_active         Boolean          @default(false) // Si las transmisiones están activas

  created_at            DateTime         @default(now())
  updated_at            DateTime         @updatedAt

  // Relations
  game      Game       @relation(fields: [game_id], references: [id], onDelete: Cascade)
  organizer User       @relation("OrganizerTournaments", fields: [organizer_id], references: [id], onDelete: Cascade)
  teams     Team[]
  matches   Match[]
  standings Standing[]

  @@index([slug])
  @@index([game_id])
  @@index([organizer_id])
  @@index([status])
  @@index([start_date])
  @@index([invite_code])
  @@map("tournaments")
}

model Team {
  id                String        @id @default(cuid())
  tournament_id     String
  name              String
  tag               String
  logo_url          String?
  captain_id        String
  seed              Int?
  registration_date DateTime      @default(now())
  approved          Boolean       @default(false)
  disqualified      Boolean       @default(false)
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt

  // Relations
  tournament      Tournament    @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  captain         User          @relation("TeamCaptain", fields: [captain_id], references: [id], onDelete: Cascade)
  players         TeamPlayer[]
  home_matches    Match[]       @relation("HomeTeam")
  away_matches    Match[]       @relation("AwayTeam")
  won_matches     Match[]       @relation("WinnerTeam")
  standings       Standing[]
  reported_by     MatchResult[] @relation("ReportingTeam")
  won_results     MatchResult[] @relation("WinningTeam")
  free_agent_invites FreeAgentInvite[]

  @@unique([tournament_id, name])
  @@unique([tournament_id, tag])
  @@index([tournament_id])
  @@index([captain_id])
  @@map("teams")
}

model TeamPlayer {
  id            String             @id @default(uuid())
  team_id       String
  user_id       String
  role          String?
  is_captain    Boolean            @default(false)
  is_substitute Boolean            @default(false)
  status        TeamPlayerStatus   @default(ACTIVE)
  joined_at     DateTime           @default(now())

  // Relations
  team Team @relation(fields: [team_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([team_id, user_id])
  @@index([team_id])
  @@index([user_id])
  @@map("team_players")
}

model Match {
  id                 String      @id @default(cuid())
  tournament_id      String
  round              Int
  match_number       Int
  bracket_position   Int
  home_team_id       String?
  away_team_id       String?
  scheduled_datetime DateTime?
  best_of            Int         @default(1)
  status             MatchStatus @default(SCHEDULED)
  winner_id          String?
  home_score         Int         @default(0)
  away_score         Int         @default(0)

  // Streaming URLs (opcional - si es diferente al del torneo)
  twitch_url         String?     // URL específica de Twitch para este partido
  youtube_url        String?     // URL específica de YouTube para este partido

  created_at         DateTime    @default(now())
  updated_at         DateTime    @updatedAt

  // Relations
  tournament Tournament    @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  home_team  Team?         @relation("HomeTeam", fields: [home_team_id], references: [id], onDelete: SetNull)
  away_team  Team?         @relation("AwayTeam", fields: [away_team_id], references: [id], onDelete: SetNull)
  winner     Team?         @relation("WinnerTeam", fields: [winner_id], references: [id], onDelete: SetNull)
  results    MatchResult[]
  checkins   MatchCheckIn[]
  reputation_reviews ReputationReview[]

  @@index([tournament_id])
  @@index([tournament_id, round])
  @@index([status])
  @@map("matches")
}

model MatchResult {
  id                    String    @id @default(cuid())
  match_id              String
  reported_by_user_id   String
  reported_by_team_id   String
  winning_team_id       String
  home_score            Int
  away_score            Int
  screenshot_url        String?
  replay_file_url       String?
  submitted_at          DateTime  @default(now())
  validated             Boolean   @default(false)
  validated_by_user_id  String?
  validated_at          DateTime?
  disputed              Boolean   @default(false)
  dispute_reason        String?   @db.Text
  ai_analysis           Json?     // AI screenshot validation results (scores, confidence, etc.)

  // Relations
  match             Match  @relation(fields: [match_id], references: [id], onDelete: Cascade)
  reported_by_user  User   @relation("ResultReporter", fields: [reported_by_user_id], references: [id], onDelete: Cascade)
  reported_by_team  Team   @relation("ReportingTeam", fields: [reported_by_team_id], references: [id], onDelete: Cascade)
  winning_team      Team   @relation("WinningTeam", fields: [winning_team_id], references: [id], onDelete: Cascade)
  validated_by_user User?  @relation("ResultValidator", fields: [validated_by_user_id], references: [id], onDelete: SetNull)

  @@index([match_id])
  @@index([reported_by_team_id])
  @@map("match_results")
}

model Standing {
  id             String   @id @default(cuid())
  tournament_id  String
  team_id        String
  played         Int      @default(0)
  won            Int      @default(0)
  lost           Int      @default(0)
  drawn          Int      @default(0)
  rounds_for     Int      @default(0)
  rounds_against Int      @default(0)
  points         Int      @default(0)
  position       Int
  updated_at     DateTime @updatedAt

  // Relations
  tournament Tournament @relation(fields: [tournament_id], references: [id], onDelete: Cascade)
  team       Team       @relation(fields: [team_id], references: [id], onDelete: Cascade)

  @@unique([tournament_id, team_id])
  @@index([tournament_id])
  @@index([tournament_id, position])
  @@map("standings")
}

model PlayerStats {
  id            String   @id @default(cuid())
  user_id       String
  game_id       String
  total_matches Int      @default(0)
  wins          Int      @default(0)
  losses        Int      @default(0)
  draws         Int      @default(0)
  win_rate      Float    @default(0)
  total_score   Int      @default(0)
  average_score Float    @default(0)
  rank          String?
  rating        Int      @default(1000)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  game Game @relation(fields: [game_id], references: [id], onDelete: Cascade)

  @@unique([user_id, game_id])
  @@index([user_id])
  @@index([game_id])
  @@index([rating])
  @@map("player_stats")
}

// ====================== CLAN MODELS ======================

model Clan {
  id            String         @id @default(cuid())
  name          String         @unique
  tag           String         @unique
  banner_url    String?
  description   String?        @db.Text
  location      String?
  access_type   ClanAccessType @default(OPEN)
  requirements  String?        @db.Text
  max_members   Int            @default(50)
  leader_id     String
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt

  // Relations
  leader        User           @relation("ClanLeader", fields: [leader_id], references: [id], onDelete: Cascade)
  members       ClanMember[]
  requests      ClanRequest[]
  messages      ClanMessage[]

  @@index([name])
  @@index([leader_id])
  @@index([access_type])
  @@map("clans")
}

model ClanMember {
  id         String         @id @default(cuid())
  clan_id    String
  user_id    String
  role       ClanMemberRole @default(MEMBER)
  joined_at  DateTime       @default(now())

  // Relations
  clan       Clan           @relation(fields: [clan_id], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([clan_id, user_id])
  @@index([clan_id])
  @@index([user_id])
  @@map("clan_members")
}

model ClanRequest {
  id         String            @id @default(cuid())
  clan_id    String
  user_id    String
  title      String
  message    String            @db.Text
  status     ClanRequestStatus @default(PENDING)
  created_at DateTime          @default(now())
  updated_at DateTime          @updatedAt

  // Relations
  clan       Clan              @relation(fields: [clan_id], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([clan_id])
  @@index([user_id])
  @@index([status])
  @@map("clan_requests")
}

model ClanMessage {
  id              String   @id @default(cuid())
  clan_id         String
  user_id         String
  content         String   @db.Text
  is_announcement Boolean  @default(false)
  created_at      DateTime @default(now())

  // Relations
  clan            Clan     @relation(fields: [clan_id], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([clan_id])
  @@index([clan_id, created_at])
  @@map("clan_messages")
}

// ====================== NOTIFICATIONS ======================

enum NotificationType {
  MATCH_READY       // Partido listo para jugar
  MATCH_RESULT      // Resultado de partido
  TOURNAMENT_START  // Torneo inicia
  TOURNAMENT_END    // Torneo finalizado
  PRIZE_RECEIVED    // Premio recibido
  WITHDRAWAL_STATUS // Estado de retiro
  TEAM_INVITE       // Invitación a equipo
  CLAN_INVITE       // Invitación a clan
  DISPUTE_UPDATE    // Actualización de disputa
  CHECK_IN_REMINDER // Recordatorio de check-in
  SYSTEM            // Notificación del sistema
}

model Notification {
  id          String           @id @default(cuid())
  user_id     String
  type        NotificationType
  title       String
  message     String           @db.Text
  data        Json?            // Metadata adicional (IDs, links, etc.)
  read        Boolean          @default(false)
  read_at     DateTime?
  created_at  DateTime         @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([user_id, read])
  @@index([created_at])
  @@map("notifications")
}

// ====================== PASSWORD RESET ======================

model PasswordResetToken {
  id          String   @id @default(cuid())
  user_id     String
  token_hash  String   @unique
  expires_at  DateTime
  used        Boolean  @default(false)
  created_at  DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([token_hash])
  @@index([expires_at])
  @@map("password_reset_tokens")
}

// ====================== MATCH CHECK-IN ======================

model MatchCheckIn {
  id            String   @id @default(cuid())
  match_id      String
  user_id       String
  team_id       String
  checked_in_at DateTime @default(now())

  match Match @relation(fields: [match_id], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([match_id, user_id])
  @@index([match_id])
  @@index([user_id])
  @@map("match_checkins")
}

// ====================== REPUTATION SYSTEM ======================

model PlayerReputation {
  id                  String   @id @default(cuid())
  user_id             String   @unique
  sportsmanship_score Float    @default(5.0)
  communication_score Float    @default(5.0)
  total_reviews       Int      @default(0)
  positive_reviews    Int      @default(0)
  negative_reviews    Int      @default(0)
  is_flagged          Boolean  @default(false)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([sportsmanship_score])
  @@map("player_reputations")
}

model ReputationReview {
  id                String   @id @default(cuid())
  reviewer_id       String
  reviewed_user_id  String
  match_id          String
  sportsmanship     Int      // 1-5
  communication     Int      // 1-5
  comment           String?  @db.Text
  created_at        DateTime @default(now())

  reviewer      User  @relation("ReviewAuthor", fields: [reviewer_id], references: [id], onDelete: Cascade)
  reviewed_user User  @relation("ReviewTarget", fields: [reviewed_user_id], references: [id], onDelete: Cascade)
  match         Match @relation(fields: [match_id], references: [id], onDelete: Cascade)

  @@unique([reviewer_id, reviewed_user_id, match_id])
  @@index([reviewed_user_id])
  @@index([match_id])
  @@map("reputation_reviews")
}

// ====================== FREE AGENT MARKET ======================

enum FreeAgentStatus {
  ACTIVE
  INACTIVE
}

enum FreeAgentInviteStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model FreeAgent {
  id              String          @id @default(cuid())
  user_id         String          @unique
  game_id         String
  bio             String?         @db.Text
  rank            String?
  preferred_role  String?
  availability    String?         // "weekdays", "weekends", "anytime"
  highlight_url   String?         @db.Text  // URL to gameplay clip
  looking_for     String          @default("competitive") // "competitive" | "casual"
  is_active       Boolean         @default(true)
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt

  user    User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  game    Game              @relation(fields: [game_id], references: [id], onDelete: Cascade)
  invites FreeAgentInvite[]

  @@index([game_id])
  @@index([is_active])
  @@index([looking_for])
  @@map("free_agents")
}

model FreeAgentInvite {
  id                String               @id @default(cuid())
  free_agent_id     String
  team_id           String
  invited_by_user_id String
  message           String?              @db.Text
  status            FreeAgentInviteStatus @default(PENDING)
  created_at        DateTime             @default(now())
  updated_at        DateTime             @updatedAt

  free_agent   FreeAgent @relation(fields: [free_agent_id], references: [id], onDelete: Cascade)
  team         Team      @relation(fields: [team_id], references: [id], onDelete: Cascade)
  invited_by   User      @relation("InviteSender", fields: [invited_by_user_id], references: [id], onDelete: Cascade)

  @@unique([free_agent_id, team_id])
  @@index([free_agent_id])
  @@index([team_id])
  @@index([status])
  @@map("free_agent_invites")
}
