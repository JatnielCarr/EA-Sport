    "event": [
        {
            "listen": "prerequest",
            "script": {
                "exec": [
                    "// Generate unique timestamp for this run",
                    "if (!pm.environment.get('run_timestamp')) {",
                    "    pm.environment.set('run_timestamp', Date.now().toString().slice(-6));",
                    "}"
                ],
                "type": "text/javascript"
            }
        }
    ],
    "item": [
        {
            "name": "Auth",
            "item": [
                {
                    "name": "Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                                    "    pm.environment.set('jwt_token', jsonData.data.token);",
                                    "    pm.environment.set('user_id', jsonData.data.user.id);",
                                    "    pm.test('Login exitoso', function() {",
                                    "        pm.response.to.have.status(200);",
                                    "    });",
                                    "} else {",
                                    "    pm.test('Login fallido (esperado con credenciales de prueba)', function() {",
                                    "        pm.expect([200, 401]).to.include(pm.response.code);",
                                    "    });",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"admin@apextournament.com\",\n    \"password\": \"admin123\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/auth/login",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "login"
                            ]
                        }
                    },
                    "response": []
                },
                {
                    "name": "Register (Unique User)",
                    "event": [
