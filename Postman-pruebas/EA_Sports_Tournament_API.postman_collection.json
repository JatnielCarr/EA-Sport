{
    "info": {
        "name": "EA Sports Tournament API - Automatizado v3",
        "description": "Colección AUTOMATIZADA v3 - Crea datos frescos para evitar conflictos",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3000",
            "type": "string"
        },
        {
            "key": "userId",
            "value": "",
            "type": "string"
        },
        {
            "key": "gameId",
            "value": "",
            "type": "string"
        },
        {
            "key": "tournamentId",
            "value": "",
            "type": "string"
        },
        {
            "key": "team1Id",
            "value": "",
            "type": "string"
        },
        {
            "key": "team2Id",
            "value": "",
            "type": "string"
        },
        {
            "key": "user2Id",
            "value": "",
            "type": "string"
        },
        {
            "key": "matchId",
            "value": "",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "🚀 FLUJO COMPLETO",
            "item": [
                {
                    "name": "1. Health Check",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Servidor OK', function() { pm.response.to.have.status(200); });",
                                    "console.log('✅ Servidor funcionando');"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "url": "{{baseUrl}}/health"
                    }
                },
                {
                    "name": "2. Crear Usuario Organizador",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "console.log('Response:', JSON.stringify(jsonData));",
                                    "if (jsonData.success && jsonData.data && jsonData.data.id) {",
                                    "    pm.collectionVariables.set('userId', jsonData.data.id);",
                                    "    console.log('✅ Usuario creado - ID: ' + jsonData.data.id);",
                                    "} else {",
                                    "    console.log('❌ Error creando usuario');",
                                    "}",
                                    "pm.test('Usuario creado', function() { pm.response.to.have.status(200); });"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "url": "{{baseUrl}}/users",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"org-{{$timestamp}}@test.com\",\n  \"username\": \"organizador-{{$timestamp}}\",\n  \"password\": \"password123\",\n  \"role\": \"ORGANIZER\"\n}"
                        }
                    }
                },
                {
                    "name": "3. Crear Juego",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "console.log('Response:', JSON.stringify(jsonData));",
                                    "if (jsonData.success && jsonData.data && jsonData.data.id) {",
                                    "    pm.collectionVariables.set('gameId', jsonData.data.id);",
                                    "    console.log('✅ Juego creado - ID: ' + jsonData.data.id);",
                                    "} else {",
                                    "    console.log('❌ Error creando juego');",
                                    "}",
                                    "pm.test('Juego creado', function() { pm.response.to.have.status(200); });"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "url": "{{baseUrl}}/games",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Clash Royale {{$timestamp}}\",\n  \"slug\": \"clash-{{$timestamp}}\",\n  \"developer\": \"Supercell\",\n  \"team_size_default\": 1\n}"
                        }
                    }
                },
                {
                    "name": "4. Verificar Variables",
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "exec": [
                                    "console.log('=== VERIFICANDO VARIABLES ===');",
                                    "console.log('userId: ' + pm.collectionVariables.get('userId'));",
                                    "console.log('gameId: ' + pm.collectionVariables.get('gameId'));"
                                ],
                                "type": "text/javascript"
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Health OK', function() { pm.response.to.have.status(200); });"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "url": "{{baseUrl}}/health"
                    }
                },
                {
                    "name": "5. Crear Torneo",
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "exec": [
                                    "var userId = pm.collectionVariables.get('userId');",
                                    "var gameId = pm.collectionVariables.get('gameId');",
                                    "console.log('PRE-REQUEST - userId: ' + userId + ', gameId: ' + gameId);",
                                    "if (!userId || !gameId) {",
                                    "    console.log('⚠️ ADVERTENCIA: userId o gameId están vacíos!');",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "console.log('Response:', JSON.stringify(jsonData));",
                                    "if (jsonData.success && jsonData.data && jsonData.data.id) {",
                                    "    pm.collectionVariables.set('tournamentId', jsonData.data.id);",
                                    "    console.log('✅ Torneo creado - ID: ' + jsonData.data.id);",
                                    "} else {",
                                    "    console.log('❌ Error: ' + JSON.stringify(jsonData));",
                                    "}",
                                    "pm.test('Torneo creado', function() { pm.response.to.have.status(200); });"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "url": "{{baseUrl}}/tournaments",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Torneo {{$timestamp}}\",\n  \"slug\": \"torneo-{{$timestamp}}\",\n  \"game_id\": \"{{gameId}}\",\n  \"organizer_id\": \"{{userId}}\",\n  \"format\": \"SINGLE_ELIMINATION\",\n  \"team_size\": 5,\n  \"max_participants\": 16,\n  \"region\": \"LATAM\",\n  \"start_date\": \"2026-12-01T10:00:00Z\",\n  \"registration_deadline\": \"2026-11-28T23:59:59Z\"\n}"
                        }
                    }
                },
                {
                    "name": "6. Crear Equipo 1",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "if (jsonData.success && jsonData.data && jsonData.data.id) {",
                                    "    pm.collectionVariables.set('team1Id', jsonData.data.id);",
                                    "    console.log('✅ Equipo 1 creado - ID: ' + jsonData.data.id);",
                                    "}",
                                    "pm.test('Equipo 1 creado', function() { pm.response.to.have.status(200); });"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "url": "{{baseUrl}}/teams",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"tournament_id\": \"{{tournamentId}}\",\n  \"name\": \"Alpha {{$timestamp}}\",\n  \"tag\": \"ALPHA\",\n  \"captain_id\": \"{{userId}}\"\n}"
                        }
                    }
                },
                {
                    "name": "7. Crear Usuario 2",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "if (jsonData.success && jsonData.data && jsonData.data.id) {",
                                    "    pm.collectionVariables.set('user2Id', jsonData.data.id);",
                                    "    console.log('✅ Usuario 2 creado - ID: ' + jsonData.data.id);",
                                    "}",
                                    "pm.test('Usuario 2 creado', function() { pm.response.to.have.status(200); });"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "url": "{{baseUrl}}/users",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"cap2-{{$timestamp}}@test.com\",\n  \"username\": \"capitan2-{{$timestamp}}\",\n  \"password\": \"password123\",\n  \"role\": \"USER\"\n}"
                        }
                    }
                },
                {
                    "name": "8. Crear Equipo 2",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "if (jsonData.success && jsonData.data && jsonData.data.id) {",
                                    "    pm.collectionVariables.set('team2Id', jsonData.data.id);",
                                    "    console.log('✅ Equipo 2 creado - ID: ' + jsonData.data.id);",
                                    "}",
                                    "pm.test('Equipo 2 creado', function() { pm.response.to.have.status(200); });"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "url": "{{baseUrl}}/teams",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"tournament_id\": \"{{tournamentId}}\",\n  \"name\": \"Beta {{$timestamp}}\",\n  \"tag\": \"BETA\",\n  \"captain_id\": \"{{user2Id}}\"\n}"
                        }
                    }
                },
                {
                    "name": "9. Crear Partida",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "if (jsonData.success && jsonData.data && jsonData.data.id) {",
                                    "    pm.collectionVariables.set('matchId', jsonData.data.id);",
                                    "    console.log('✅ Partida creada - ID: ' + jsonData.data.id);",
                                    "}",
                                    "pm.test('Partida creada', function() { pm.response.to.have.status(200); });"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "url": "{{baseUrl}}/matches",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"tournament_id\": \"{{tournamentId}}\",\n  \"round\": 1,\n  \"match_number\": 1,\n  \"bracket_position\": 1,\n  \"home_team_id\": \"{{team1Id}}\",\n  \"away_team_id\": \"{{team2Id}}\",\n  \"best_of\": 3\n}"
                        }
                    }
                },
                {
                    "name": "10. Iniciar Partida",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Partida LIVE', function() { pm.response.to.have.status(200); });",
                                    "console.log('✅ Partida en VIVO');"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "PUT",
                        "url": "{{baseUrl}}/matches/{{matchId}}",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"status\": \"LIVE\",\n  \"home_score\": 0,\n  \"away_score\": 0\n}"
                        }
                    }
                },
                {
                    "name": "11. Completar Partida",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Partida completada', function() { pm.response.to.have.status(200); });",
                                    "console.log('✅ Partida COMPLETADA');"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "PUT",
                        "url": "{{baseUrl}}/matches/{{matchId}}",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"status\": \"COMPLETED\",\n  \"home_score\": 2,\n  \"away_score\": 1,\n  \"winner_id\": \"{{team1Id}}\"\n}"
                        }
                    }
                },
                {
                    "name": "12. Ver Bracket",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Bracket OK', function() { pm.response.to.have.status(200); });",
                                    "var jsonData = pm.response.json();",
                                    "console.log('✅ Bracket: ' + (jsonData.data?.matches?.length || 0) + ' partidas');"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "url": "{{baseUrl}}/tournaments/{{tournamentId}}/bracket"
                    }
                },
                {
                    "name": "13. Resumen Final",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "console.log('=== RESUMEN ===');",
                                    "console.log('userId: ' + pm.collectionVariables.get('userId'));",
                                    "console.log('gameId: ' + pm.collectionVariables.get('gameId'));",
                                    "console.log('tournamentId: ' + pm.collectionVariables.get('tournamentId'));",
                                    "console.log('team1Id: ' + pm.collectionVariables.get('team1Id'));",
                                    "console.log('team2Id: ' + pm.collectionVariables.get('team2Id'));",
                                    "console.log('matchId: ' + pm.collectionVariables.get('matchId'));",
                                    "console.log('✅ TODAS LAS PRUEBAS COMPLETADAS');",
                                    "pm.test('Resumen OK', function() { pm.response.to.have.status(200); });"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "url": "{{baseUrl}}/health"
                    }
                }
            ]
        },
        {
            "name": "📋 CONSULTAS",
            "item": [
                {
                    "name": "Ver Usuarios",
                    "request": {
                        "method": "GET",
                        "url": "{{baseUrl}}/users"
                    }
                },
                {
                    "name": "Ver Juegos",
                    "request": {
                        "method": "GET",
                        "url": "{{baseUrl}}/games"
                    }
                },
                {
                    "name": "Ver Torneos",
                    "request": {
                        "method": "GET",
                        "url": "{{baseUrl}}/tournaments"
                    }
                },
                {
                    "name": "Ver Equipos",
                    "request": {
                        "method": "GET",
                        "url": "{{baseUrl}}/teams"
                    }
                },
                {
                    "name": "Ver Partidas",
                    "request": {
                        "method": "GET",
